<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SaveSlots</AssemblyName>
    <Version>1.0.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- the game folder; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Baby Steps</GameDir>
    <ML>$(GameDir)\MelonLoader</ML>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ML)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(ML)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(ML)\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(ML)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(ML)\Il2CppAssemblies\*.dll" Private="false" />
    <Reference Include="$(GameDir)\Mods\BabyStepsMenuLib.dll" Private="false" />
  </ItemGroup>
</Project>
